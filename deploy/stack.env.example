# Variables del stack de Portainer (Environment variables → "Load variables from .env file").
# Copia este fichero a un .env LOCAL, rellénalo y súbelo a Portainer. NO lo subas a git.
#
# Generar secretos:
#   POSTGRES_PASSWORD  → openssl rand -hex 24        (hex: sin caracteres que rompan la URL)
#   VAPID_*            → npx web-push generate-vapid-keys
#   BOT_SECRET         → openssl rand -hex 32        (debe ser fijo: cambiarlo invalida los bots de partidas en curso)

# ── Base de datos ──────────────────────────────────────────────
POSTGRES_DB=elpueblo
POSTGRES_USER=elpueblo
POSTGRES_PASSWORD=CAMBIAME
BACKUP_KEEP=14

# ── Web y CORS ─────────────────────────────────────────────────
PUBLIC_URL=https://pueblo.xelements.es
LOG_LEVEL=info

# ── Narración con Gemini (opcional: sin clave se usan plantillas) ──
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
NARRATOR_TIMEOUT_MS=8000

# ── Avisos Web Push (opcional: sin claves no hay avisos) ─────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# ── Bots ───────────────────────────────────────────────────────
BOT_SECRET=CAMBIAME

# ── Límites ────────────────────────────────────────────────────
CHAT_MESSAGES_PER_10S=5
